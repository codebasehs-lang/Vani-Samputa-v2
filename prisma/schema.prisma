generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  AUDIO
  VIDEO
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash; null for OAuth-only accounts
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  favorites UserFavorite[]
  notes     UserNote[]
  history   UserHistory[]
  progress  UserProgress[]
  pushSubs  PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Playlist {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  language    String    // "Odia" | "Hindi" | "English" | "Sanskrit"
  category    String
  mediaType   MediaType
  coverUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lectures Lecture[]
}

model Lecture {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  mediaType   MediaType
  url         String    // audio file URL or YouTube video ID
  duration    Int?      // seconds (audio only)
  language    String
  category    String
  thumbnail   String?
  transcript  String?   @db.LongText
  sortOrder   Int       @default(0)
  playCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  favorites UserFavorite[]
  notes     UserNote[]
  history   UserHistory[]
  progress  UserProgress[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  body        String    @db.LongText
  excerpt     String?   @db.Text
  coverUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DailyVerse {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  sanskrit   String   @db.Text
  devanagari String?  @db.Text
  odia       String?  @db.Text
  hindi      String?  @db.Text
  english    String?  @db.Text
  source     String?  // e.g. "Bhagavad Gita 18.65"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── User Activity ────────────────────────────────────────────────────────────

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  lectureId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
}

model UserNote {
  id         String   @id @default(cuid())
  userId     String
  lectureId  String
  content    String   @db.Text
  timestampS Int      // playback position in seconds
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model UserHistory {
  id        String   @id @default(cuid())
  userId    String
  lectureId String
  playedAt  DateTime @default(now())
  durationS Int?     // seconds listened this session

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  lectureId String
  positionS Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
}

// ─── Platform Config ──────────────────────────────────────────────────────────

model LiveConfig {
  id            String    @id @default(cuid())
  channelId     String
  streamUrl     String?
  isLive        Boolean   @default(false)
  autoFetch     Boolean   @default(true)
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  startAt     DateTime
  endAt       DateTime?
  location    String?
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

